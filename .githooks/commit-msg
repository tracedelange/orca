#!/bin/sh
# Conventional commits, so release-please can write the changelog and pick the version.
head -1 "$1" | grep -qE '^((feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]+\))?!?: .+|Merge |Revert |fixup! |squash! )' && exit 0
echo "commit message must be conventional, for example: feat(viewer): add a palette" >&2
echo "types: feat fix docs style refactor perf test build ci chore revert; add ! for a breaking change" >&2
exit 1
