{
  "name": "orca",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "orca": "bin/orca.js",
    "nodes": "bin/orca.js"
  },
  "scripts": {
    "start": "node bin/orca-server.js",
    "setup": "npm install && npm link && orca install-hooks && orca start",
