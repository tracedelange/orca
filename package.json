{
  "name": "@tdelange/orca",
  "version": "0.3.0",
  "description": "One map for all of your Claude Code sessions, and one place that tells you which session needs you now.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tracedelange/orca.git"
  },
  "type": "module",
  "bin": {
    "orca": "bin/orca.js",
    "nodes": "bin/orca.js"
  },
  "files": [
    "bin",
    "dist",
    "web",
    "templates"
  ],
  "os": [
    "darwin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node bin/orca-server.js",
    "test": "node --test test/*.test.ts",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=test/** test/*.test.ts",
    "typecheck": "tsc",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null; npm run build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "d3": "^7.9.0",
    "marked": "^18.0.14",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
